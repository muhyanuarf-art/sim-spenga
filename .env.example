APP_NAME="SIM-SPENGA"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Jakarta
APP_URL=http://localhost:8000
APP_LOCALE=id

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sim_spenga
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=480

CACHE_STORE=database
# PENTING: 'database' berarti job (mis. kirim WA) diproses di BACKGROUND oleh
# `php artisan queue:work`, tidak ikut menunggu di request website. Jangan
# diubah ke 'sync' kalau fitur notifikasi WA dipakai — 'sync' membuat proses
# kirim WA berjalan LANGSUNG di request guru menyimpan absensi (bikin lambat).
QUEUE_CONNECTION=database

FILESYSTEM_DISK=local

# Gateway WhatsApp (Fonnte) untuk notifikasi Alfa ke orang tua.
# Daftar & dapatkan token di https://fonnte.com — device WA harus terhubung/scan QR dulu.
FONNTE_TOKEN=
FONNTE_URL=https://api.fonnte.com/send
