/.phpunit.cache
/node_modules
/public/build
/public/hot
/public/storage
/storage/*.key
/storage/pail
/vendor
.env
.env.backup
.env.production
.phpunit.result.cache
Homestead.json
Homestead.yaml
auth.json
npm-debug.log
yarn-error.log
/.fleet
/.idea
/.nova
/.vscode
/.zed

# Laravel runtime output — jangan ikut di-commit (log & cache view/session
# berubah tiap kali aplikasi jalan, bukan bagian dari kode sumber).
/storage/logs/*
!/storage/logs/.gitkeep
/storage/framework/cache/*
!/storage/framework/cache/.gitkeep
/storage/framework/sessions/*
!/storage/framework/sessions/.gitkeep
/storage/framework/testing/*
!/storage/framework/testing/.gitkeep
/storage/framework/views/*
!/storage/framework/views/.gitkeep

# ---------------------------------------------------------------------
# RAHASIA & BERKAS UNGGAHAN — jangan pernah masuk ke repositori.
#
# Ditambahkan setelah ditemukan bahwa .env.backup-sebelum-rotate (berisi
# token WhatsApp yang masih berlaku) dan foto bukti pelanggaran siswa
# sudah terlanjur ter-commit. Aturan di bawah mencegah kejadian yang sama
# terulang; berkas yang SUDAH terlanjur masuk riwayat harus dibersihkan
# terpisah — .gitignore tidak berlaku surut untuk berkas yang sudah
# terlacak.
# ---------------------------------------------------------------------
.env.*
!.env.example
!.env.production.example
*.env.backup*

# Unggahan pengguna: bukti pelanggaran & pembinaan BK, lampiran surat,
# logo sekolah. Isinya milik sekolah, bukan bagian dari kode aplikasi —
# dan sebagiannya data pribadi siswa.
/storage/app/private
/storage/app/public/bk
/storage/app/public/surat-lampiran
/storage/app/public/pengaturan-sekolah
/storage/app/public/ikon

# Cadangan database
/storage/app/cadangan
*.sql
