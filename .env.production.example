# =====================================================================
# SETELAN UNTUK SERVER SEKOLAH (PRODUKSI)
# =====================================================================
# Salin berkas ini jadi `.env` di server, lalu isi bagian yang bertanda
# <ISI>. JANGAN memakai .env pengembangan apa adanya — beberapa setelan
# di bawah ini yang membedakan pemasangan aman dan pemasangan bocor.
#
#   cp .env.production.example .env
#   php artisan key:generate
#   php artisan migrate --force
#   php artisan storage:link
#   php artisan config:cache && php artisan route:cache && php artisan view:cache
#
# Setelah itu buka aplikasinya sekali dan masukkan NOMOR SERI di halaman
# aktivasi yang muncul.
# =====================================================================

APP_NAME="SIM-SPENGA"

# WAJIB 'production'. Nilai 'local' membuat Laravel longgar di beberapa tempat.
APP_ENV=production

# WAJIB false.
# Kalau true, setiap galat menampilkan jejak kesalahan LENGKAP kepada siapa
# pun yang memicunya — termasuk isi .env, yaitu kata sandi database. Ini
# kebocoran paling sering terjadi pada aplikasi Laravel yang dipasang
# terburu-buru.
APP_DEBUG=false

# Dibuat sekali dengan: php artisan key:generate
# JANGAN disalin dari server lain: kunci ini yang mengenkripsi cookie sesi
# dan menandatangani aktivasi lisensi.
APP_KEY=

# Alamat lengkap tempat aplikasi diakses, termasuk https:// bila ada.
APP_URL=https://<ISI-alamat-sekolah>

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_TIMEZONE=Asia/Jakarta

# ---------------------------------------------------------------------
# DATABASE
# ---------------------------------------------------------------------
# Jangan memakai pengguna 'root' tanpa kata sandi. Buat pengguna khusus
# yang hanya berhak atas database ini.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=<ISI-nama-database>
DB_USERNAME=<ISI-pengguna-database>
DB_PASSWORD=<ISI-kata-sandi-yang-kuat>

# ---------------------------------------------------------------------
# SESI & KEAMANAN COOKIE
# ---------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_ENCRYPT=true

# WAJIB true bila aplikasi diakses lewat https.
# Bila false, cookie login ikut terkirim pada koneksi tanpa enkripsi dan
# bisa dicuri di jaringan yang sama (mis. wifi sekolah).
SESSION_SECURE_COOKIE=true

# Membatasi cookie agar tidak ikut terkirim dari situs lain (anti-CSRF berlapis).
SESSION_SAME_SITE=lax

# ---------------------------------------------------------------------
# LISENSI
# ---------------------------------------------------------------------
# Sidik nomor seri sudah tertanam di config/lisensi.php. Isi di sini HANYA
# bila penyedia menerbitkan nomor seri baru.
# LISENSI_HASH=
LISENSI_PEMEGANG="SMP Negeri 3 Bumiayu"

# Aktivasi terikat alamat server: menyalin aplikasi ke server lain menuntut
# nomor seri lagi. Ubah ke false hanya bila alamatnya memang sering berubah.
LISENSI_TERIKAT_HOST=true

# ---------------------------------------------------------------------
# LOG & ANTREAN
# ---------------------------------------------------------------------
LOG_CHANNEL=daily
LOG_LEVEL=warning
QUEUE_CONNECTION=database
CACHE_STORE=database

# ---------------------------------------------------------------------
# NOTIFIKASI WHATSAPP (opsional)
# ---------------------------------------------------------------------
# Perangkat 1 — nomor SEKOLAH. Mengirim pemberitahuan siswa Alfa ke
# ORANG TUA. Ambil tokennya di dasbor Fonnte -> Device.
# FONNTE_TOKEN=
# FONNTE_URL=https://api.fonnte.com/send
#
# Perangkat 2 — nomor KEPALA SEKOLAH. Mengirim pengingat jurnal &
# absensi ke GURU. Biasanya TIDAK diisi di sini melainkan lewat menu
# Pengaturan -> Pengingat Guru (WA), yang menyimpannya terenkripsi di
# database. Isi di sini hanya bila sekolah lebih suka menaruh
# rahasianya di berkas .env.
# FONNTE_TOKEN_GURU=
