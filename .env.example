APP_NAME="SIM-SPENGA"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Jakarta
APP_URL=http://localhost:8000
APP_LOCALE=id

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sim_spenga
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=480

CACHE_STORE=database
# PENTING: 'database' berarti job (mis. kirim WA) diproses di BACKGROUND oleh
# `php artisan queue:work`, tidak ikut menunggu di request website. Jangan
# diubah ke 'sync' kalau fitur notifikasi WA dipakai — 'sync' membuat proses
# kirim WA berjalan LANGSUNG di request guru menyimpan absensi (bikin lambat).
QUEUE_CONNECTION=database

FILESYSTEM_DISK=local

# Gateway WhatsApp (Fonnte) untuk notifikasi Alfa ke orang tua.
# Daftar & dapatkan token di https://fonnte.com — device WA harus terhubung/scan QR dulu.
FONNTE_TOKEN=
FONNTE_URL=https://api.fonnte.com/send

# =============================================================================
# LISENSI — DIISI FF PRODUCTION SAAT MEMASANG, BUKAN OLEH SEKOLAH
# =============================================================================
# Nilai KODE dan TOKEN didapat dari server lisensi dengan menjalankan
# di sana:
#
#     php artisan sekolah:daftar <kode-sekolah> --nama="Nama Sekolah" --bulan=12
#
# Perintah itu menampilkan kedua baris di bawah sekali saja — salin
# langsung ke sini. Yang tersimpan di server hanya sidiknya, jadi tidak
# ada cara membacanya kembali nanti.
#
# 'lokal'  = nomor seri diperiksa di dalam aplikasi ini sendiri (cara lama)
# 'server' = diperiksa ke ffproduction.com — INI yang dipakai untuk
#            pemasangan yang dikelola FF Production.
LISENSI_MODE=server
LISENSI_SERVER="https://ffproduction.com"

# Kunci PUBLIK penandatangan. Sama untuk semua sekolah, aman dilihat siapa
# pun — ia hanya bisa MEMERIKSA tanda tangan, tidak bisa membuatnya.
# Pasangan rahasianya tidak boleh pernah meninggalkan server ffproduction.com.
LISENSI_KUNCI_PUBLIK=""

# Kredensial pemasangan ini. Berbeda untuk setiap sekolah.
LISENSI_KODE=
LISENSI_TOKEN=

# =============================================================================
# BACKUP TERENKRIPSI
# =============================================================================
# Backup berisi dump database LENGKAP beserta APP_KEY, jadi tidak pernah
# dibuat tanpa enkripsi — perintahnya menolak jalan bila BACKUP_SANDI kosong.
#
# Isi dengan kalimat panjang, lalu SIMPAN KALIMAT ITU DI LUAR SERVER
# (ponsel Kepala Sekolah, pengelola kata sandi). Tanpa kalimat ini,
# backup tidak bisa dibuka oleh siapa pun — termasuk Anda sendiri.
BACKUP_SANDI=
BACKUP_TUJUAN=
BACKUP_SIMPAN=30
